BILLING_API_KEY=dev-key-123
BILLING_DB_PATH=data/billing.db
BILLING_RAW_LOG_DIR=data/raw-log
BILLING_PLAN_PATH=src/billing_engine/price_plans.json
BILLING_STAGE=local
LOG_LEVEL=INFO

# Streaming mode (optional). Leave BILLING_KAFKA_BOOTSTRAP empty to keep the
# SQLite inbox. `make stream-up` sets these inside the Compose stack.
# BILLING_KAFKA_BOOTSTRAP=localhost:29092
# BILLING_KAFKA_TOPIC=usage-events
# BILLING_KAFKA_DLQ_TOPIC=usage-events-dlq
# BILLING_KAFKA_GROUP=billing-worker
# BILLING_KAFKA_OFFSET_RESET=earliest
# BILLING_KAFKA_PROPERTIES={}
